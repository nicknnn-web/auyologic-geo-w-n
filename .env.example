# 前端环境变量（构建时使用）
VITE_API_URL=/api
# 部署时填实际后端地址，如：https://your-backend.sealos.app
VITE_API_TARGET=https://your-backend.sealos.app

# 后端：大模型接入管理 — API Key 密文加密密钥（至少 16 字符，勿泄露、勿入库）
# AI_CREDENTIALS_SECRET=your-long-random-secret-string-here

# 品牌体检 — 博查 Web Search（信源穿透，每题检索一次）
# BOCHA_API_KEY=你的博查密钥（请写在 backend/.env，勿提交仓库）
# BOCHA_BASE_URL=https://api.bochaai.com/v1/web-search
# GEO_BOCHA_COUNT=8
# GEO_BOCHA_SEARCH_CONCURRENCY=1
# GEO_BOCHA_MIN_INTERVAL_MS=1500
# GEO_BOCHA_RETRY_MAX=5
# GEO_BOCHA_RETRY_BASE_MS=3000
# GEO_SOURCE_CLASSIFY_CONCURRENCY=3
