# 数据库
DATABASE_URL=postgresql://postgres:your_password@your_host:5432/auyologic

# 服务端口
PORT=3001

# 发帖 Playwright：生产环境默认无头。本地调试可设为 true 弹出浏览器
# PLAYWRIGHT_HEADED=true

# 浏览器二进制装进 node_modules（与 Zeabur 一致，避免只存在 ~/.cache）
# PLAYWRIGHT_BROWSERS_PATH=0

# AI 密钥（可选，后端会从数据库读取用户配置的密钥）
# 默认密钥（可选）
DEFAULT_DEEPSEEK_API_KEY=
DEFAULT_DOUBAO_API_KEY=
DEFAULT_KIMI_API_KEY=
