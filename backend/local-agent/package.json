{
  "name": "auyologic-agent",
  "version": "1.0.0",
  "description": "Auyologic 本地授权代理 - 在本机运行浏览器完成平台账号授权",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "postinstall": "node scripts/install-playwright.mjs",
    "playwright:install": "PLAYWRIGHT_BROWSERS_PATH=0 npx playwright install chromium",
    "build": "pkg index.js --target node18-win-x64 --output dist/auyologic-agent.exe"
  },
  "dependencies": {
    "playwright": "^1.58.2"
  },
  "devDependencies": {
    "pkg": "^5.8.1"
  },
  "pkg": {
    "scripts": ["auth.js", "playwrightLaunch.js"],
    "assets": []
  }
}
